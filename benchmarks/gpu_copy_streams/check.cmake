# Functional benchmark regressions. No assertions on noisy latency thresholds.
set(args -ll:gpu 1 -ll:cpu 2 -ll:fsize 32 -ll:csize 64 -ll:zsize 16
         -path local -iters 2 -level 4)
set(expected 0)
if(CASE STREQUAL "placement")
  list(APPEND args -load-tasks 1 -load-place 2 -load-blocks 128 -load-spin 32
       -load-delay-us 0 -samples -verify)
elseif(CASE STREQUAL "aligned_capacity")
  list(APPEND args -ll:fsize 8 -bytes 3145728 -rects 1 -pad 1)
  set(expected 77)
elseif(CASE STREQUAL "load_capacity")
  list(APPEND args -ll:fsize 8 -bytes 2621440 -rects 1 -pad 0 -load-tasks 1)
  set(expected 77)
elseif(CASE STREQUAL "launch_error")
  list(APPEND args -load-tasks 1 -load-threads 2048 -load-blocks 16)
  set(expected failure)
elseif(CASE STREQUAL "zero_grid")
  list(APPEND args -load-tasks 1 -load-blocks 0)
  set(expected failure)
elseif(CASE STREQUAL "verify")
  list(APPEND args -verify -samples -bg 2 -bg-bytes 65536 -bg-rects 4)
elseif(CASE STREQUAL "invalid_args")
  list(APPEND args -iters 0)
  set(expected failure)
else()
  message(FATAL_ERROR "Unknown benchmark regression: ${CASE}")
endif()
set(launcher)
if(MPIEXEC_EXECUTABLE)
  list(APPEND launcher "${MPIEXEC_EXECUTABLE}" "${MPIEXEC_NUMPROC_FLAG}" 1
       ${MPIEXEC_PREFLAGS})
endif()
execute_process(COMMAND ${launcher} "${PROGRAM}" ${MPIEXEC_POSTFLAGS} ${args}
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
message("${out}${err}")
if(expected STREQUAL "failure")
  if(status STREQUAL "0" OR status STREQUAL "77" OR status MATCHES "[Tt]imeout")
    message(FATAL_ERROR "Invalid workload unexpectedly succeeded or timed out: ${status}")
  endif()
else()
  if(NOT status STREQUAL "${expected}")
    message(FATAL_ERROR "Expected ${expected}, received ${status}")
  endif()
endif()
if(CASE STREQUAL "placement")
  if(NOT out MATCHES "RESULT path=local.*load_gpus=1" OR
     NOT out MATCHES "LOAD_GPU path=local.*mean_task_span_ms=" OR
     NOT out MATCHES "LOAD path=local.*first_n=1" OR
     NOT out MATCHES "VERIFY path=local.*errors=0")
    message(FATAL_ERROR "Missing local destination load, task timing or verification")
  endif()
elseif(expected STREQUAL "77")
  if(NOT out MATCHES "SKIP path=local: instances do not fit")
    message(FATAL_ERROR "Capacity check did not skip the oversized workload")
  endif()
elseif(CASE STREQUAL "launch_error")
  if(NOT err MATCHES "load kernel launch failed")
    message(FATAL_ERROR "Launch failed without the expected diagnostic")
  endif()
elseif(CASE STREQUAL "zero_grid")
  if(NOT err MATCHES "invalid load kernel grid/block dimensions")
    message(FATAL_ERROR "Invalid grid failed without the expected diagnostic")
  endif()
elseif(CASE STREQUAL "verify")
  if(NOT out MATCHES "VERIFY path=local.*errors=0")
    message(FATAL_ERROR "Missing payload verification")
  endif()
elseif(CASE STREQUAL "invalid_args")
  if(NOT err MATCHES "invalid gpu_copy_streams arguments")
    message(FATAL_ERROR "Invalid arguments failed without the expected diagnostic")
  endif()
endif()
